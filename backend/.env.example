NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://liralink:liralink@localhost:5434/liralink
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PAY_WEB_BASE_URL=http://localhost:5174/p

STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
PLATFORM_ACCOUNT_SECRET=S...          # collection account; `make keys` generates it into backend/.env
USDC_CODE=USDC
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Soroban invoice contract (testnet), see docs/deployments.md
INVOICE_CONTRACT_ID=                  # `make contract` deploys one and writes it into backend/.env; empty disables the contract rail

# Demo merchant login (demo@liralink.app) used by `npm run seed`; any local value, 8+ chars
SEED_DEMO_PASSWORD=

FX_PROVIDER=mock                      # mock | live | anchor (SEP-38 quote from ANCHOR_HOME_DOMAIN)
FX_MOCK_RATE_TRY_PER_USDC=34.00
FX_LIVE_URL=                          # optional public rate endpoint

ANCHOR_PROVIDER=mock                  # mock | sep24 | sep6
ANCHOR_HOME_DOMAIN=                   # sep6: tr-mock-anchor.fly.dev · sep24: testanchor.stellar.org
ANCHOR_SEP24_TEST_KYC_URL=            # testanchor only: https://anchor-reference-server-testanchor.stellar.org
# SEP-24 withdraw body format for this anchor: multipart (default) | urlencoded
ANCHOR_SEP24_ENCODING=multipart
ANCHOR_MOCK_DELAY_MS=3000

LINK_DEFAULT_EXPIRY_HOURS=24
QUOTE_TTL_MINUTES=10

# x402 agent payments (GET /pay/:code/agent) — Coinbase's x402.org facilitator, testnet only; empty disables
X402_FACILITATOR_URL=https://x402.org/facilitator
