// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LinkStatus {
  open
  underpaid
  paid
  expired
  cancelled
}

enum PayRail {
  contract
  memo
  x402
}

enum SettleStatus {
  pending
  processing
  completed
  failed
}

enum WdStatus {
  requested
  processing
  completed
  failed
}

model Merchant {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  businessName    String
  iban            String?
  autoSavePercent Int      @default(0)
  // Excess USDC from overpaid links, parked here rather than auto-converted —
  // visible to the merchant, handled manually (refund or credit at current rate).
  unallocatedUSDC Decimal  @default(0) @db.Decimal(20, 7)
  createdAt       DateTime @default(now())

  links           PaymentLink[]
  settlements     Settlement[]
  withdrawals     Withdrawal[]
  usdcWithdrawals UsdcWithdrawal[]
}

model PaymentLink {
  id                     String     @id @default(uuid())
  code                   String     @unique
  merchantId             String
  merchant               Merchant   @relation(fields: [merchantId], references: [id])
  title                  String
  description            String?
  amountTRY              Decimal    @db.Decimal(20, 7)
  quotedUSDC             Decimal    @db.Decimal(20, 7)
  fxRate                 Decimal    @db.Decimal(20, 7)
  quoteExpiresAt         DateTime
  status                 LinkStatus @default(open)
  expiresAt              DateTime
  // Cumulative USDC matched to this link so far (across partial + completing
  // payments). Settlement always credits the locked `amountTRY`, never
  // `receivedUSDC * fxRate` — see PaymentsService.
  receivedUSDC           Decimal    @default(0) @db.Decimal(20, 7)
  // Set only while status is `underpaid`; cleared once the link is paid.
  shortfallUSDC          Decimal?   @db.Decimal(20, 7)
  // Soroban invoice rail — set by POST /links/:id/onchain. `contractId` pins the deployment
  // holding the invoice, so a contract redeploy leaves older links off-chain again.
  contractId             String?
  // null when the invoice already existed on-chain (idempotent retry after a lost response)
  contractTxHash         String?
  contractDeadlineLedger Int?
  createdAt              DateTime   @default(now())

  // One row per successful transfer that credited this link (partial installments
  // AND the completing payment) — a link can accumulate several. See PaymentsService.
  payments Payment[]

  @@index([code])
  @@index([merchantId, createdAt])
}

model Payment {
  id           String      @id @default(uuid())
  // NOT unique: a link can have multiple payments (partial top-ups + completion).
  // Idempotency is enforced by the unique txHash, not by one-payment-per-link.
  linkId       String
  link         PaymentLink @relation(fields: [linkId], references: [id])
  txHash       String      @unique
  payerAddress String
  amountUSDC   Decimal     @db.Decimal(20, 7)
  // 'memo' = classic text-memo payment (Horizon listener); 'contract' = paid through
  // the Soroban invoice contract (InvoiceContractService, RPC getEvents).
  rail         PayRail     @default(memo)
  ledger       Int
  detectedAt   DateTime    @default(now())

  settlement Settlement?

  @@index([linkId])
}

model Settlement {
  id          String       @id @default(uuid())
  merchantId  String
  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  paymentId   String       @unique
  payment     Payment      @relation(fields: [paymentId], references: [id])
  amountUSDC  Decimal      @db.Decimal(20, 7)
  amountTRY   Decimal      @db.Decimal(20, 7)
  fxRate      Decimal      @db.Decimal(20, 7)
  savedUSDC   Decimal      @default(0) @db.Decimal(20, 7)
  // Set on completion: the anchor's fee (USDC) and the TRY credited / paid out after it,
  // amountTRY × (amountUSDC − feeUSDC) / amountUSDC. Null on rows completed before fees were
  // recorded (all mock, fee 0) — balance and the API read those as net = gross.
  feeUSDC     Decimal?     @db.Decimal(20, 7)
  netTRY      Decimal?     @db.Decimal(20, 7)
  provider    String
  status      SettleStatus @default(pending)
  // mock: mock-settle-…; sep24: the anchor's transaction id
  anchorRef   String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  // sep24 progress. interactiveUrl = the anchor's interactive (KYC) page.
  interactiveUrl String?
  // Last SEP-24 transaction status seen (incomplete, pending_user_transfer_start, …). While it is
  // `incomplete` at a real anchor, the merchant still has to complete interactiveUrl.
  anchorStatus   String?
  // Why a `pending` settlement can't proceed yet (outside_anchor_limits | missing_iban |
  // anchor_withdraw_disabled); the minute job retries it.
  blockedReason  String?
  // Why a `failed` settlement failed — terminal, never retried (unexpected_fee_asset |
  // invalid_fee | anchor_status | amount_mismatch). Null on every other status.
  failReason     String?
  // USDC payment platform → anchor. The signed XDR is persisted BEFORE submitting, so a retry
  // resubmits the same transaction instead of sending the USDC twice.
  anchorTxHash   String?
  anchorTxXdr    String?
}

model Withdrawal {
  id          String    @id @default(uuid())
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id])
  amountTRY   Decimal   @db.Decimal(20, 7)
  iban        String
  status      WdStatus  @default(requested)
  anchorRef   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

enum X402SettleStatus {
  pending
  settled
  failed
}

// An x402 settle whose facilitator call timed out (outcome unknown). The minute job looks for the
// transfer on Horizon, retries the settle while the signed auth entries are valid (`expiresAt`),
// and fails the row once they expired with nothing on-chain. Settled rows keep the tx hash.
model X402Settlement {
  id             String           @id @default(uuid())
  linkCode       String
  // From the facilitator's verify — informational only, never used to match a transfer.
  payer          String?
  // sha256 of the payer-signed Soroban auth entries in the payload. The facilitator rebuilds the
  // transaction (own source + fee bump), so the tx hash isn't known before settle — but it copies
  // these entries verbatim, and their nonce lands on-chain once. Reconcile matches only on this.
  authEntriesHash String?
  amountUSDC     Decimal          @db.Decimal(20, 7)
  paymentPayload Json
  requirements   Json
  status         X402SettleStatus @default(pending)
  attempts       Int              @default(0)
  txHash         String?
  // not_settled_before_expiry
  failReason     String?
  lastError      String?
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

enum UsdcWdSource {
  saved
  unallocated
}

enum UsdcWdStatus {
  submitted
  completed
  failed
}

// USDC sent from the platform account to the merchant's own Stellar address (POST /usdc-withdrawals).
// The amount is debited when the row is created: `unallocated` decrements merchant.unallocatedUSDC in
// the same transaction; `saved` counts against savedUSDC while not failed. A failed row releases it.
// The signed XDR + hash are persisted BEFORE submitting, so a retry resubmits the same transaction.
model UsdcWithdrawal {
  id          String       @id @default(uuid())
  merchantId  String
  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  amountUSDC  Decimal      @db.Decimal(20, 7)
  destination String
  source      UsdcWdSource
  status      UsdcWdStatus @default(submitted)
  txHash      String       @unique
  txXdr       String
  // failed_on_ledger | expired_unsubmitted — terminal, the debit is released
  failReason  String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([merchantId, createdAt])
  @@index([status])
}

// Idempotency for the Horizon payment listener — one row per processed operation id.
model ProcessedOperation {
  opId        String   @id
  processedAt DateTime @default(now())
}

// Single-row table persisting the Horizon payments-stream paging token,
// so a listener restart resumes instead of skipping or replaying from scratch.
model ListenerCursor {
  id          String   @id @default("horizon-payments")
  pagingToken String
  updatedAt   DateTime @updatedAt
}

// Inbound Horizon operations that matched the platform account/asset but were
// not credited as a Payment (underpaid, unmatched code, wrong state, etc.) —
// kept for support/debugging rather than silently dropped.
model PaymentAttempt {
  id         String   @id @default(uuid())
  opId       String   @unique
  // Decoded memo, kept as plain text (NOT a foreign key) — an attempt with a
  // memo matching no real link at all is exactly one of the cases this table
  // exists to capture, so it can't be constrained to an existing PaymentLink.code.
  linkCode   String?
  txHash     String
  fromAddr   String
  amountUSDC Decimal  @db.Decimal(20, 7)
  assetCode  String
  reason     String
  createdAt  DateTime @default(now())
}
